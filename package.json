{
  "name": "iphone-batch-manager",
  "version": "1.5.10",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.36",
    "expo-av": "~16.0.0",
    "expo-background-fetch": "~14.0.9",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.6.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --tunnel --go",
    "start:go:clear": "expo start --tunnel --go --clear",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "build:apk": "eas build -p android --profile apk --non-interactive",
    "bench": "node scripts/bench-hotpaths.mjs",
    "bench:r2": "node scripts/bench-round2.mjs"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "uuid": "11.1.1",
    "undici": "6.28.0",
    "tar": "7.5.21",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@4": "5.0.9",
    "brace-expansion@5": "5.0.9",
    "js-yaml@3": "3.15.1",
    "js-yaml@4": "4.3.1"
  }
}

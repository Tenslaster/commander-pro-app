{
  "name": "iphone-batch-manager",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.36",
    "expo-av": "~16.0.0",
    "expo-background-fetch": "~14.0.9",
    "expo-device": "~8.0.10",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "scripts": {
    "start": "expo start --tunnel --go",
    "start:tunnel": "expo start --tunnel --go",
    "start:clear": "expo start --tunnel --go --clear",
    "android": "expo start --tunnel --go --android",
    "ios": "expo start --tunnel --go --ios",
    "web": "expo start --web",
    "build:apk": "eas build -p android --profile apk --non-interactive"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3"
  }
